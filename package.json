  "scripts": {
    "build": "tsup && tsup --config tsup.precise.config.ts && node scripts/build-esm.mjs",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test --test-reporter=dot $(find src -name '*.test.ts' -type f)",
    "test:verbose": "node --import tsx --test $(find src -name '*.test.ts' -type f)",
    "test:watch": "node --import tsx --test --watch $(find src -name '*.test.ts' -type f)",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "npm run check:types && npm run check:lint && npm run build && npm run check:consumer && npm run check:coverage && npm run check:size && npm run check:perf && npm run check:api && npm run check:ratchet",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "docs:serve": "npx serve docs",
    "release:patch": "npm run check && npm version patch -m 'Release v%s' && git push && git push --tags",
    "release:minor": "npm run check && npm version minor -m 'Release v%s' && git push && git push --tags",
    "release:major": "npm run check && npm version major -m 'Release v%s' && git push && git push --tags",
    "check:types": "npm run typecheck",
    "check:lint": "npm run lint",
    "check:coverage": "node scripts/guard/coverage.mjs",
    "check:size": "node scripts/guard/size.mjs",
    "check:perf": "node scripts/guard/perf.mjs",
    "check:api": "node scripts/guard/api.mjs",
    "check:ratchet": "node --test scripts/guard/*.test.mjs && node scripts/guard/ratchet.mjs",
    "check:precision": "node --import tsx --test src/ephemeris/horizons-fixtures.test.ts",
    "budgets:update": "npm run build && node scripts/guard/coverage.mjs --update && node scripts/guard/size.mjs --update && node scripts/guard/perf.mjs --update && node scripts/guard/api.mjs --update",
    "check:consumer": "node scripts/guard/consumer.mjs"
  },
