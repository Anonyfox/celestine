{
  "name": "celestine",
  "version": "0.8.0",
  "description": "Astrology and astronomy engine in TypeScript: charts, houses, aspects, transits, stations and progressions. Positions checked against JPL Horizons in CI. Zero runtime dependencies; browser and Node.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ephemeris": {
      "import": {
        "types": "./dist/ephemeris/index.d.ts",
        "default": "./dist/ephemeris/index.js"
      },
      "require": {
        "types": "./dist/ephemeris/index.d.cts",
        "default": "./dist/ephemeris/index.cjs"
      }
    },
    "./time": {
      "import": {
        "types": "./dist/time/index.d.ts",
        "default": "./dist/time/index.js"
      },
      "require": {
        "types": "./dist/time/index.d.cts",
        "default": "./dist/time/index.cjs"
      }
    },
    "./zodiac": {
      "import": {
        "types": "./dist/zodiac/index.d.ts",
        "default": "./dist/zodiac/index.js"
      },
      "require": {
        "types": "./dist/zodiac/index.d.cts",
        "default": "./dist/zodiac/index.cjs"
      }
    },
    "./aspects": {
      "import": {
        "types": "./dist/aspects/index.d.ts",
        "default": "./dist/aspects/index.js"
      },
      "require": {
        "types": "./dist/aspects/index.d.cts",
        "default": "./dist/aspects/index.cjs"
      }
    },
    "./transits": {
      "import": {
        "types": "./dist/transits/index.d.ts",
        "default": "./dist/transits/index.js"
      },
      "require": {
        "types": "./dist/transits/index.d.cts",
        "default": "./dist/transits/index.cjs"
      }
    },
    "./chart": {
      "import": {
        "types": "./dist/chart/index.d.ts",
        "default": "./dist/chart/index.js"
      },
      "require": {
        "types": "./dist/chart/index.d.cts",
        "default": "./dist/chart/index.cjs"
      }
    },
    "./houses": {
      "import": {
        "types": "./dist/houses/index.d.ts",
        "default": "./dist/houses/index.js"
      },
      "require": {
        "types": "./dist/houses/index.d.cts",
        "default": "./dist/houses/index.cjs"
      }
    },
    "./progressions": {
      "import": {
        "types": "./dist/progressions/index.d.ts",
        "default": "./dist/progressions/index.js"
      },
      "require": {
        "types": "./dist/progressions/index.d.cts",
        "default": "./dist/progressions/index.cjs"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/events/index.d.ts",
        "default": "./dist/events/index.js"
      },
      "require": {
        "types": "./dist/events/index.d.cts",
        "default": "./dist/events/index.cjs"
      }
    },
    "./precise": {
      "import": {
        "types": "./dist/precise/index.d.ts",
        "default": "./dist/precise/index.js"
      },
      "require": {
        "types": "./dist/precise/index.d.cts",
        "default": "./dist/precise/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.precise.config.ts && node scripts/build-esm.mjs",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test --test-reporter=dot $(find src -name '*.test.ts' -type f)",
    "test:verbose": "node --import tsx --test $(find src -name '*.test.ts' -type f)",
    "test:watch": "node --import tsx --test --watch $(find src -name '*.test.ts' -type f)",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "npm run check:types && npm run check:lint && npm run build && npm run check:consumer && npm run check:coverage && npm run check:size && npm run check:perf && npm run check:api && npm run check:ratchet",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc && node scripts/bench/accuracy.mjs --check",
    "bench:accuracy": "node scripts/bench/accuracy.mjs",
    "docs:serve": "npx serve docs",
    "release:patch": "npm run check && npm version patch -m 'Release v%s' && git push && git push --tags",
    "release:minor": "npm run check && npm version minor -m 'Release v%s' && git push && git push --tags",
    "release:major": "npm run check && npm version major -m 'Release v%s' && git push && git push --tags",
    "check:types": "npm run typecheck",
    "check:lint": "npm run lint",
    "check:coverage": "node scripts/guard/coverage.mjs",
    "check:size": "node scripts/guard/size.mjs",
    "check:perf": "node scripts/guard/perf.mjs",
    "check:api": "node scripts/guard/api.mjs",
    "check:ratchet": "node --test scripts/guard/*.test.mjs && node scripts/guard/ratchet.mjs",
    "check:precision": "node --import tsx --test src/ephemeris/horizons-fixtures.test.ts",
    "budgets:update": "npm run build && node scripts/guard/coverage.mjs --update && node scripts/guard/size.mjs --update && node scripts/guard/perf.mjs --update && node scripts/guard/api.mjs --update",
    "check:consumer": "node scripts/guard/consumer.mjs"
  },
  "keywords": [
    "astrology",
    "ephemeris",
    "birth-chart",
    "natal-chart",
    "horoscope",
    "transits",
    "houses",
    "placidus",
    "jpl-horizons",
    "vsop87",
    "typescript",
    "zero-dependency",
    "astronomy",
    "moon-phase",
    "retrograde",
    "zodiac",
    "aspects",
    "planets",
    "progressions",
    "astro"
  ],
  "author": {
    "name": "Anonyfox",
    "email": "max@anonyfox.com",
    "url": "https://anonyfox.com"
  },
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Anonyfox"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Anonyfox/celestine.git"
  },
  "bugs": {
    "url": "https://github.com/Anonyfox/celestine/issues"
  },
  "homepage": "https://anonyfox.github.io/celestine",
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "rollup": "4.65.1",
    "tsup": "^9.0.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.15",
    "typescript": "^6.0.3"
  },
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "ephemeris": [
        "dist/ephemeris/index.d.ts"
      ],
      "time": [
        "dist/time/index.d.ts"
      ],
      "zodiac": [
        "dist/zodiac/index.d.ts"
      ],
      "aspects": [
        "dist/aspects/index.d.ts"
      ],
      "transits": [
        "dist/transits/index.d.ts"
      ],
      "chart": [
        "dist/chart/index.d.ts"
      ],
      "houses": [
        "dist/houses/index.d.ts"
      ],
      "progressions": [
        "dist/progressions/index.d.ts"
      ],
      "events": [
        "dist/events/index.d.ts"
      ],
      "precise": [
        "dist/precise/index.d.ts"
      ]
    }
  }
}
